{
  "name": "tscn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tscn": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test262:fetch": "npm run build && node dist/test262/fetch.js",
    "test262:run": "npm run build && node dist/test262/run.js",
    "test262:baseline": "npm run build && node dist/test262/run.js --classification fail --baseline test262/baseline.json",
    "lint": "npx oxlint --type-aware"
  },
  "dependencies": {
    "@effect/cli": "^0.75.2",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "effect": "^3.21.2",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.22"
}
